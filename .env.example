# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | openrouter | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Tuỳ chọn khi đánh giá bằng OpenRouter; model embedding có thể phát sinh phí.
# RAGAS_EMBEDDING_MODEL=openai/text-embedding-3-small

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
